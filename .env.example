# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.
# Estas variáveis (VITE_*) ficam visíveis no navegador: use só chaves públicas.
# Nunca coloque aqui a chave service_role do Supabase.

# Supabase: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS: Email Services, Email Templates e Account > General
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
